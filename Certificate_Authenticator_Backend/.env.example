# Copy this file to .env and fill in your own values.

# Database
DB_URL=jdbc:postgresql://localhost:5432/CertificateAuthenticator
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Blockchain
BLOCKCHAIN_NODE_URL=https://sepolia.infura.io/v3/your_infura_project_id
BLOCKCHAIN_CONTRACT_ADDRESS=0xYourContractAddress
BLOCKCHAIN_PRIVATE_KEY=your_wallet_private_key

# File uploads
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
